{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "tsBuildInfoFile": "node_modules/.cache/tsconfig.web.tsbuildinfo"
  },
  "include": [
    "next-env.d.ts",
    "ts-reset.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next",
    "out",
    ".stryker-tmp",
    "reports",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/infrastructure/scan",
    "src/infrastructure/scan-explorer"
  ]
}
