{
  "name": "groundwork",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The systems a company runs, and the plans that change them.",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "prepare": "lefthook install",
    "postinstall": "patch-package --error-on-fail --error-on-warn",
    "typecheck": "tsc --noEmit",
    "typecoverage": "type-coverage",
    "lint": "eslint --cache --cache-strategy content --cache-location node_modules/.cache/eslint/ --concurrency auto --max-warnings 0 .",
    "lint:changed": "node tools/lint-changed.ts",
    "design:drift": "node --import ./tools/register.ts tools/design-drift.ts",
    "budget": "node --import ./tools/register.ts tools/page-budget.ts",
    "lint:css": "stylelint --cache --cache-location node_modules/.cache/stylelint/ \"src/**/*.css\"",
    "format": "prettier --write --cache --cache-location node_modules/.cache/prettier.json .",
    "format:check": "prettier --check --cache --cache-location node_modules/.cache/prettier.json .",
    "cycles": "dpdm --no-warning --no-tree -T --exit-code circular:1 'src/**/*.{ts,tsx}' 'tools/**/*.ts'",
    "knip": "knip",
    "generate": "node tools/generate-plan-types.ts",
    "test": "vitest run --project unit",
    "test:changed": "vitest run --project unit --changed",
    "test:architecture": "vitest run --project architecture",
    "coverage": "vitest run --coverage",
    "mutate": "stryker run",
    "mutate:changed": "node tools/mutate-changed.ts",
    "check:static": "run-p --aggregate-output --print-label typecheck typecoverage lint:css design:drift format:check cycles knip",
    "check": "run-p --aggregate-output --print-label check:static lint coverage",
    "map": "node --import ./tools/register.ts --conditions=react-server tools/map.ts",
    "plan:base": "node --import ./tools/register.ts --conditions=react-server tools/plan-base.ts",
    "workspace": "node --import ./tools/register.ts --conditions=react-server tools/workspace.ts"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@eslint/js": "9.39.5",
    "@stryker-mutator/api": "10.0.0",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@total-typescript/ts-reset": "0.6.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.4",
    "@vitest/eslint-plugin": "1.6.27",
    "dpdm": "4.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-boundaries": "7.2.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-no-secrets": "2.3.3",
    "eslint-plugin-no-unsanitized": "4.1.5",
    "eslint-plugin-regexp": "3.3.1",
    "eslint-plugin-security": "4.2.0",
    "eslint-plugin-sonarjs": "4.2.2",
    "eslint-plugin-testing-library": "7.16.2",
    "eslint-plugin-unicorn": "78.0.0",
    "happy-dom": "21.0.1",
    "json-schema-to-typescript": "^16.0.0",
    "knip": "6.41.0",
    "lefthook": "2.2.2",
    "npm-run-all2": "9.0.3",
    "patch-package": "8.0.1",
    "postcss": "8.5.30",
    "postcss-selector-parser": "7.1.6",
    "prettier": "3.9.10",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0",
    "stylelint-declaration-strict-value": "1.12.1",
    "type-coverage": "2.30.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.4"
  },
  "overrides": {
    "handlebars": "4.7.10"
  },
  "typeCoverage": {
    "atLeast": 100,
    "strict": true,
    "ignoreCatch": true,
    "detail": true,
    "cache": true,
    "cacheDirectory": "node_modules/.cache/type-coverage",
    "ignoreFiles": [
      "**/*.test.ts",
      "**/*.test.tsx",
      "test/**",
      ".stryker-tmp/**"
    ],
    "reportUnusedIgnore": true,
    "showRelativePath": true
  }
}
