{
  "name": "groundwork-v2",
  "private": true,
  "version": "0.4.12",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.ts",
    "build": "npm run content:validate && npm run schemas:check && tsc -b && vite build && npm run build:runtime",
    "lint": "oxlint",
    "test": "node --test --import ./tests/setup.ts tests/*.test.ts",
    "content:validate": "node scripts/content.ts",
    "content:schemas": "node scripts/schemas.ts",
    "content:check-schemas": "node scripts/schemas.ts check",
    "build:runtime": "tsc -p tsconfig.runtime.json",
    "schemas:portable": "node scripts/schemas.ts",
    "prepack": "npm run build",
    "groundwork": "node bin/groundwork-v2.js",
    "schemas:check-portable": "node scripts/schemas.ts check",
    "start": "npm run build && node bin/groundwork-v2.js hub",
    "test:package": "npm pack && node scripts/package-smoke.ts",
    "schemas": "node scripts/schemas.ts",
    "schemas:check": "node scripts/schemas.ts check"
  },
  "dependencies": {
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "@xyflow/react": "^12.11.6",
    "clsx": "^2.1.1",
    "d3-force": "^3.0.0",
    "elkjs": "^0.12.0",
    "lucide-react": "^1.41.0",
    "oxlint": "^1.79.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  },
  "bin": {
    "groundwork-v2": "bin/groundwork-v2.js"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "files": [
    "bin",
    "runtime",
    "dist",
    "schemas",
    ".agents/skills/groundwork-system-catalog/SKILL.md",
    ".agents/skills/groundwork-system-catalog/references",
    "docs/PORTABLE.md",
    "README.md"
  ]
}
