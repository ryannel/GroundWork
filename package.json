{
  "name": "groundwork-v2",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run content:validate && npm run content:check-schemas && npm run schemas:check-portable && tsc -b && vite build && npm run build:runtime",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "node --test tests/*.test.ts",
    "content:validate": "node scripts/content.ts",
    "content:schemas": "node scripts/content.ts schemas",
    "content:check-schemas": "node scripts/content.ts check-schemas",
    "build:runtime": "tsc -p tsconfig.runtime.json",
    "schemas:portable": "node scripts/runtime-schemas.ts",
    "prepack": "npm run build",
    "groundwork": "node bin/groundwork-v2.js",
    "schemas:check-portable": "node scripts/runtime-schemas.ts check"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.41.0",
    "motion": "^13.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.79.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  },
  "bin": {
    "groundwork-v2": "bin/groundwork-v2.js"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "files": [
    "bin",
    "runtime",
    "dist",
    "schemas",
    "docs/PORTABLE.md",
    "README.md"
  ]
}
