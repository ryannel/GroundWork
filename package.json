{
  "name": "groundwork",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The systems a company runs, and the plans that change them.",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "prepare": "lefthook install",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --cache --cache-strategy content --cache-location node_modules/.cache/eslint/ --max-warnings 0 .",
    "lint:changed": "node tools/lint-changed.ts",
    "lint:css": "stylelint --cache --cache-location node_modules/.cache/stylelint/ \"src/**/*.css\"",
    "format": "prettier --write --cache --cache-location node_modules/.cache/prettier.json .",
    "format:check": "prettier --check --cache --cache-location node_modules/.cache/prettier.json .",
    "cycles": "dpdm --no-warning --no-tree -T --exit-code circular:1 'src/**/*.{ts,tsx}' 'tools/**/*.ts'",
    "knip": "knip",
    "generate": "node tools/generate-plan-types.ts",
    "test": "vitest run --project unit",
    "test:changed": "vitest run --project unit --changed",
    "test:architecture": "vitest run --project architecture",
    "coverage": "vitest run --coverage",
    "check": "run-p --aggregate-output --print-label typecheck lint lint:css format:check cycles knip coverage",
    "map": "node --import ./tools/register.ts --conditions=react-server tools/map.ts",
    "plan:base": "node --import ./tools/register.ts --conditions=react-server tools/plan-base.ts",
    "workspace": "node --import ./tools/register.ts --conditions=react-server tools/workspace.ts"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.4",
    "dpdm": "4.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-boundaries": "7.2.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-sonarjs": "4.2.2",
    "eslint-plugin-unicorn": "64.0.0",
    "happy-dom": "21.0.1",
    "json-schema-to-typescript": "^16.0.0",
    "knip": "6.41.0",
    "lefthook": "2.2.2",
    "npm-run-all2": "9.0.3",
    "postcss": "8.5.30",
    "postcss-selector-parser": "7.1.6",
    "prettier": "3.9.10",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0",
    "stylelint-declaration-strict-value": "1.12.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.4"
  }
}
