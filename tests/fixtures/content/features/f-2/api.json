                "type": "integer"
              },
              {
                "name": "tax",
                "type": "number"
              },
              {
                "name": "taxRate",
                "type": "number | null"
              }
            ]
          },
          {
            "name": "totals",
            "type": "object",
            "fields": [
              {
                "name": "net",
                "type": "integer"
              },
              {
                "name": "flatTaxRate",
                "type": "number"
              },
              {
                "name": "tax",
                "type": "number | null"
              },
              {
                "name": "taxStatus",
                "type": "\"quoted\" | \"pending\""
              },
              {
                "name": "gross",
                "type": "integer"
              }
            ]
          }
        ],
        "after": [
          {
            "name": "id",
            "type": "string"
          },
          {
            "name": "deliverTo",
            "type": "object | null",
            "fields": [
              {
                "name": "country",
                "type": "string"
              }
            ]
          },
          {
            "name": "lines",
            "type": "array",
            "fields": [
              {
                "name": "id",
                "type": "string"
              },
              {
                "name": "net",
                "type": "integer"
              },
              {
                "name": "tax",
                "type": "number | null",
                "note": "Now nullable while the delivery region is unknown."
              },
              {
                "name": "taxRate",
                "type": "number | null"
              },
              {
                "name": "taxRuleId",
                "type": "string | null"
              }
            ]
          },
          {
            "name": "totals",
            "type": "object",
            "fields": [
              {
                "name": "net",
                "type": "integer"
              },
              {
                "name": "tax",
                "type": "number | null"
              },
              {
                "name": "taxStatus",
                "type": "\"quoted\" | \"pending\""
              },
              {
                "name": "gross",
                "type": "integer"
              }
            ]
          }
        ]
      },
      "response": "{\n  id: \"crt_9\",\n  deliverTo: { country: \"DE\" } | null,\n  lines: [{ id: \"l1\", net: 4200, tax: 798 | null, taxRate: 0.19 | null, taxRuleId: \"r_de_std_v7\" | null }],\n  totals: { net: 4200, tax: 798 | null, taxStatus: \"quoted\" | \"pending\", gross: 4998 }\n}",
      "note": "Migration required: clients must handle pending tax and stop reading totals.flatTaxRate before this contract is released."
    },
    {
      "id": "api-deliver-to",
