      "change": "added",
      "from": "c-sdk",
      "to": "c-cart-svc",
      "method": "PUT",
      "path": "/v1/carts/{id}/deliver-to",
      "request": "{ country: \"DE\", subdivision?: \"BY\", postal?: \"80331\" }",
      "response": "Cart (as GET /v1/carts/{id})",
      "responseSchema": {
        "after": [
          {
            "name": "id",
            "type": "string"
          },
          {
            "name": "deliverTo",
            "type": "object | null",
            "fields": [
              {
                "name": "country",
                "type": "string"
              }
            ]
          },
          {
            "name": "lines",
            "type": "array",
            "fields": [
              {
                "name": "id",
                "type": "string"
              },
              {
                "name": "net",
                "type": "integer"
              },
              {
                "name": "tax",
                "type": "number | null",
                "note": "Now nullable while the delivery region is unknown."
              },
              {
                "name": "taxRate",
                "type": "number | null"
              },
              {
                "name": "taxRuleId",
                "type": "string | null"
              }
            ]
          },
          {
            "name": "totals",
            "type": "object",
            "fields": [
              {
                "name": "net",
                "type": "integer"
              },
              {
                "name": "tax",
                "type": "number | null"
              },
              {
                "name": "taxStatus",
                "type": "\"quoted\" | \"pending\""
              },
              {
                "name": "gross",
                "type": "integer"
              }
            ]
          }
