    {
      "id": "api-flat-rate",
      "name": "Flat tax rate lookup",
      "change": "removed",
      "from": "c-cart-svc",
      "to": "c-pricing-api",
      "method": "GET",
      "path": "/v1/tax/rate?storefront=",
      "responseSchema": {
        "before": [
          {
            "name": "rate",
            "type": "number"
          }
        ]
      },
      "note": "Replaced by the quote endpoint. Remove once no storefront calls it for 7 days."
    },
    {
      "id": "api-publish-rule",
      "name": "Publish rule",
      "change": "added",
      "from": "c-rules",
      "to": "c-rules",
      "method": "POST",
      "path": "/v1/rules/tax",
      "request": "{ region: \"DE\", categoryId?: \"apparel\", merchantId?: \"m_1\", rate: 0.19, effectiveAt: \"2026-09-05T00:00:00Z\" }",
      "response": "{ id: \"r_de_std_v8\", supersedes: \"r_de_std_v7\" }",
      "responseSchema": {
        "after": [
          {
            "name": "id",
            "type": "string"
          },
          {
            "name": "supersedes",
            "type": "string | null"
          }
        ]
      },
      "note": "Finance console only. Validates the region and refuses effectiveAt in the past."
    },
    {
      "id": "api-rule-published",
      "name": "Rule published",
      "change": "added",
      "from": "c-rules",
      "to": "c-pricing-api",
      "method": "EVENT",
      "path": "pricing.tax-rule.published",
      "request": "{ ruleId: \"r_de_std_v8\", replaces: \"r_de_std_v7\", region: \"DE\", effectiveAt: \"2026-09-05T00:00:00Z\" }",
      "note": "Consumer invalidates every cache entry whose region prefix matches."
    }
