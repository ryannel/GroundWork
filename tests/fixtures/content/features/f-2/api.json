{
  "contracts": [
    {
      "id": "api-add-line",
      "name": "Add cart item",
      "change": "updated",
      "from": "c-sdk",
      "to": "c-cart-svc",
      "method": "POST",
      "path": "/v1/carts/{id}/lines",
      "request": "{ productId: \"p_shirt\", quantity: 1 }",
      "response": "Cart (as GET /v1/carts/{id})",
      "responseSchema": {
        "before": [
          {
            "name": "id",
            "type": "string"
          },
          {
            "name": "deliverTo",
            "type": "object | null",
            "fields": [
              {
                "name": "country",
                "type": "string"
              }
            ]
          },
          {
            "name": "lines",
            "type": "array",
            "fields": [
              {
                "name": "id",
                "type": "string"
              },
              {
                "name": "net",
                "type": "integer"
              },
              {
                "name": "tax",
                "type": "number"
              },
              {
                "name": "taxRate",
                "type": "number | null"
              }
            ]
          },
          {
            "name": "totals",
            "type": "object",
            "fields": [
              {
                "name": "net",
                "type": "integer"
              },
              {
                "name": "flatTaxRate",
                "type": "number"
              },
              {
                "name": "tax",
                "type": "number | null"
              },
              {
                "name": "taxStatus",
                "type": "\"quoted\" | \"pending\""
              },
              {
                "name": "gross",
                "type": "integer"
              }
            ]
          }
        ],
        "after": [
          {
            "name": "id",
            "type": "string"
          },
          {
            "name": "deliverTo",
            "type": "object | null",
            "fields": [
              {
                "name": "country",
                "type": "string"
              }
            ]
          },
          {
            "name": "lines",
            "type": "array",
            "fields": [
              {
                "name": "id",
                "type": "string"
              },
              {
                "name": "net",
                "type": "integer"
              },
              {
                "name": "tax",
                "type": "number | null",
                "note": "Now nullable while the delivery region is unknown."
              },
              {
                "name": "taxRate",
                "type": "number | null"
              },
              {
                "name": "taxRuleId",
                "type": "string | null"
              }
            ]
          },
          {
            "name": "totals",
            "type": "object",
            "fields": [
              {
                "name": "net",
                "type": "integer"
              },
              {
                "name": "tax",
                "type": "number | null"
              },
              {
                "name": "taxStatus",
                "type": "\"quoted\" | \"pending\""
              },
              {
                "name": "gross",
                "type": "integer"
              }
            ]
          }
        ]
      },
      "note": "Existing endpoint with the updated Cart response. Saves the added line and tax state before returning the cart to the storefront."
    },
    {
      "id": "api-quote",
      "name": "Quote tax for cart lines",
      "change": "added",
      "from": "c-cart-svc",
      "to": "c-pricing-api",
      "method": "POST",
      "path": "/v2/tax/quote",
      "request": "{\n  region: { country: \"DE\", subdivision?: \"BY\", postal?: \"80331\" },\n  merchantId: \"m_123\",\n  lines: [{ lineId: \"l1\", categoryId: \"apparel\", net: 4200, currency: \"EUR\" }]\n}",
      "response": "{\n  lines: [{ lineId: \"l1\", tax: 798, rate: 0.19, ruleId: \"r_de_std_v7\" }],\n  total: 798,\n  explain: \"DE standard rate 19% (apparel)\"\n}",
      "responseSchema": {
        "after": [
          {
            "name": "lines",
            "type": "array",
            "fields": [
              {
                "name": "lineId",
                "type": "string"
              },
              {
                "name": "tax",
                "type": "integer"
              },
              {
                "name": "rate",
                "type": "number"
              },
              {
                "name": "ruleId",
                "type": "string"
              }
            ]
          },
          {
            "name": "total",
            "type": "integer"
          },
          {
            "name": "explain",
            "type": "string"
          }
        ]
      },
      "note": "Idempotent. 40ms budget. Returns 422 if any line has an unknown category."
    },
