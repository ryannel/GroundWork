{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://groundwork.local/schema/knowledge-v1",
  "title": "KnowledgeDocument",
  "oneOf": [
    {
      "$ref": "#/$defs/KnowledgeBundle"
    },
    {
      "$ref": "#/$defs/KnowledgeSnapshot"
    },
    {
      "$ref": "#/$defs/QueryRequest"
    },
    {
      "$ref": "#/$defs/QueryResponse"
    }
  ],
  "$defs": {
    "Evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "const": "evidence"
        },
        "repo": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "lines": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "minItems": 2,
          "maxItems": 2
        },
        "basis": {
          "enum": [
            "source",
            "test_assertion"
          ]
        }
      },
      "required": [
        "id",
        "kind",
        "repo",
        "commit",
        "path",
        "lines",
        "basis"
      ]
    },
    "Artifact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "const": "artifact"
        },
        "coordinate": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "sourceCommit": {
          "type": [
            "string",
            "null"
          ]
        },
        "correspondence": {
          "enum": [
            "declared",
            "candidate",
            "verified"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "digest": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "id",
        "kind",
        "coordinate",
        "version",
        "sourceCommit",
        "correspondence",
        "evidence",
        "digest"
      ]
    },
    "Resolution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "const": "resolution"
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "requestedArtifact": {
          "type": [
            "string",
            "null"
          ]
        },
        "basis": {
          "enum": [
            "source_local",
            "artifact_verified",
            "unresolved"
          ]
        },
        "target": {
          "type": [
            "string",
            "null"
          ]
        },
        "candidates": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "binding": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "kind",
        "owner",
        "requestedArtifact",
        "basis",
        "target",
        "candidates",
        "evidence",
        "binding"
      ]
    },
    "Implementation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "const": "implementation"
        },
        "logicalId": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "entry": {
          "type": "string",
          "minLength": 1
        },
        "parameters": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "id",
        "kind",
        "logicalId",
        "scope",
        "entry",
        "parameters",
        "evidence"
      ]
    },
    "Operation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "const": "operation"
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "enum": [
            "entry",
            "compute",
            "branch",
            "call",
            "return",
            "throw",
            "opaque"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "resolution": {
          "type": [
            "string",
            "null"
          ]
        },
        "bindings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "parameter": {
                "type": "string",
                "minLength": 1
              },
              "value": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "parameter",
              "value"
            ]
          }
        },
        "result": {
          "type": [
            "string",
            "null"
          ]
        },
        "exit": {
          "type": [
            "string",
            "null"
          ]
        },
        "httpStatus": {
          "type": [
            "integer",
            "null"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "id",
        "kind",
        "owner",
        "action",
        "label",
        "resolution",
        "bindings",
        "result",
        "exit",
        "httpStatus",
        "evidence"
      ]
    },
    "Transition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "const": "transition"
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "from": {
          "type": "string",
          "minLength": 1
        },
        "to": {
          "type": "string",
          "minLength": 1
        },
        "on": {
          "type": "string",
          "minLength": 1
        },
        "condition": {
          "type": [
            "string",
            "null"
          ]
        },
        "values": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "id",
        "kind",
        "owner",
        "from",
        "to",
        "on",
        "condition",
        "values",
        "evidence"
      ]
    },
    "Value": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "const": "value"
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "definition": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": [
            "parameter",
            "definition",
            "field",
            "constant"
          ]
        },
        "representation": {
          "$ref": "#/$defs/Representation"
        },
        "shape": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "accessPath": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "id",
        "kind",
        "owner",
        "definition",
        "label",
        "role",
        "representation",
        "shape",
        "evidence",
        "accessPath"
      ]
    },
    "ValueFlow": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "const": "flow"
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "from": {
          "type": "string",
          "minLength": 1
        },
        "to": {
          "type": "string",
          "minLength": 1
        },
        "at": {
          "type": "string",
          "minLength": 1
        },
        "transform": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "gaps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "id",
        "kind",
        "owner",
        "from",
        "to",
        "at",
        "transform",
        "evidence",
        "gaps",
        "assumptions"
      ]
    },
    "Shape": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "const": "shape"
        },
        "representation": {
          "$ref": "#/$defs/Representation"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "enum": [
                  "declared",
                  "candidate"
                ]
              }
            },
            "required": [
              "name",
              "type",
              "status"
            ]
          }
        },
        "completeness": {
          "enum": [
            "partial",
            "closed"
          ]
        },
        "gaps": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "id",
        "kind",
        "representation",
        "label",
        "fields",
        "completeness",
        "gaps",
        "evidence"
      ]
    },
    "Effect": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "const": "effect"
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "operation": {
          "type": "string",
          "minLength": 1
        },
        "effect": {
          "enum": [
            "read",
            "write",
            "call",
            "publish"
          ]
        },
        "resource": {
          "type": "string",
          "minLength": 1
        },
        "modality": {
          "enum": [
            "source_declared",
            "source_traced"
          ]
        },
        "representation": {
          "enum": [
            "logical",
            "physical"
          ]
        },
        "selection": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "payload": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "id",
        "kind",
        "owner",
        "operation",
        "effect",
        "resource",
        "modality",
        "representation",
        "selection",
        "payload",
        "evidence"
      ]
    },
    "Gap": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "const": "gap"
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "obligation": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "id",
        "kind",
        "owner",
        "obligation",
        "reason",
        "action",
        "evidence"
      ]
    },
    "Coverage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "const": "coverage"
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "obligation": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "examined",
            "partial",
            "not_examined"
          ]
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "gaps": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "id",
        "kind",
        "owner",
        "obligation",
        "status",
        "scope",
        "gaps",
        "evidence"
      ]
    },
    "Claim": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "const": "claim"
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "basis": {
          "enum": [
            "source_declared",
            "source_traced",
            "test_asserted"
          ]
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "id",
        "kind",
        "owner",
        "statement",
        "basis",
        "inputs",
        "assumptions",
        "evidence"
      ]
    },
    "Derivation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "const": "derivation"
        },
        "output": {
          "type": "string",
          "minLength": 1
        },
        "rule": {
          "type": "string",
          "minLength": 1
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "id",
        "kind",
        "output",
        "rule",
        "inputs"
      ]
    },
    "KnowledgeRecord": {
      "oneOf": [
        {
          "$ref": "#/$defs/Evidence"
        },
        {
          "$ref": "#/$defs/Artifact"
        },
        {
          "$ref": "#/$defs/Resolution"
        },
        {
          "$ref": "#/$defs/Implementation"
        },
        {
          "$ref": "#/$defs/Operation"
        },
        {
          "$ref": "#/$defs/Transition"
        },
        {
          "$ref": "#/$defs/Value"
        },
        {
          "$ref": "#/$defs/ValueFlow"
        },
        {
          "$ref": "#/$defs/Shape"
        },
        {
          "$ref": "#/$defs/Effect"
        },
        {
          "$ref": "#/$defs/Gap"
        },
        {
          "$ref": "#/$defs/Coverage"
        },
        {
          "$ref": "#/$defs/Claim"
        },
        {
          "$ref": "#/$defs/Derivation"
        },
        {
          "$ref": "#/$defs/SourceRevision"
        },
        {
          "$ref": "#/$defs/Entry"
        },
        {
          "$ref": "#/$defs/Resource"
        },
        {
          "$ref": "#/$defs/ArtifactSourceBinding"
        }
      ]
    },
    "KnowledgeBundle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "format": {
          "const": "groundwork-knowledge/v1"
        },
        "workspace": {
          "type": "string",
          "minLength": 1
        },
        "records": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/KnowledgeRecord"
          }
        }
      },
      "required": [
        "format",
        "workspace",
        "records"
      ]
    },
    "KnowledgeSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "format": {
          "const": "groundwork-snapshot/v1"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "bundles": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "interpretations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "rules": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "format",
        "id",
        "bundles",
        "interpretations",
        "rules"
      ]
    },
    "QueryRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "format": {
          "const": "groundwork-query/v1"
        },
        "snapshot": {
          "type": "string",
          "minLength": 1
        },
        "query": {
          "enum": [
            "trace",
            "value",
            "outcome",
            "effects",
            "impact"
          ]
        },
        "entry": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": [
            "string",
            "null"
          ]
        },
        "context": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "outcome": {
          "type": [
            "integer",
            "null"
          ]
        },
        "changed": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "representation": {
          "$ref": "#/$defs/Representation"
        },
        "candidates": {
          "const": "exclude"
        },
        "maxNodes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2000
        }
      },
      "required": [
        "format",
        "snapshot",
        "query",
        "entry",
        "value",
        "context",
        "outcome",
        "changed",
        "representation",
        "candidates",
        "maxNodes"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "query": {
                "const": "value"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "else": {
            "properties": {
              "context": {
                "maxItems": 0,
                "type": "array"
              },
              "value": {
                "const": null
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "query": {
                "const": "outcome"
              }
            }
          },
          "then": {
            "properties": {
              "outcome": {
                "type": "integer",
                "minimum": 100,
                "maximum": 599
              }
            }
          },
          "else": {
            "properties": {
              "outcome": {
                "const": null
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "query": {
                "const": "impact"
              }
            }
          },
          "then": {
            "properties": {
              "changed": {
                "minItems": 1,
                "type": "array"
              }
            }
          },
          "else": {
            "properties": {
              "changed": {
                "type": "array",
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "QueryNode": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "record": {
          "type": "string",
          "minLength": 1
        },
        "context": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "label": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "record",
        "context",
        "label"
      ]
    },
    "QueryEdge": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "from": {
          "type": "string",
          "minLength": 1
        },
        "to": {
          "type": "string",
          "minLength": 1
        },
        "on": {
          "type": "string",
          "minLength": 1
        },
        "condition": {
          "type": [
            "string",
            "null"
          ]
        },
        "assumption": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence": {
