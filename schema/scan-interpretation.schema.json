{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://groundwork.local/schema/scan-interpretation-v1",
  "title": "ScanInterpretation",
  "$defs": {
    "Pin": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repo": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        }
      },
      "required": [
        "repo",
        "commit"
      ]
    },
    "ObservedReference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "observed_record"
        },
        "context_id": {
          "type": "string",
          "minLength": 1
        },
        "record_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind",
        "context_id",
        "record_id"
      ]
    },
    "ContextReference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "context_snapshot"
        },
        "context_id": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "lines": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "minItems": 2,
          "maxItems": 2
        }
      },
      "required": [
        "kind",
        "context_id",
        "locator",
        "lines"
      ]
    },
    "Evidence": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "observed_record"
            },
            "context_id": {
              "type": "string",
              "minLength": 1
            },
            "record_id": {
              "type": "string",
              "minLength": 1
            },
            "source_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            }
          },
          "required": [
            "kind",
            "context_id",
            "record_id",
            "source_ids"
          ]
        },
        {
          "$ref": "#/$defs/ContextReference"
        }
      ]
    },
    "EntityReference": {
      "oneOf": [
        {
          "$ref": "#/$defs/ObservedReference"
        },
        {
          "$ref": "#/$defs/ContextReference"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "inferred_claim"
            },
            "claim_id": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "claim_id"
          ]
        }
      ]
    },
    "InputProvenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provided_by": {
          "enum": [
            "user",
            "workspace",
            "connected_source"
          ]
        },
        "retrieved_at": {
          "type": "string",
          "format": "date-time"
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "provided_by",
        "retrieved_at",
        "description"
      ]
    },
    "Context": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "role": {
              "enum": [
                "target",
                "surrounding"
              ]
            },
            "kind": {
              "const": "scan_snapshot"
            },
            "scan_id": {
              "type": "string",
              "minLength": 1
            },
            "repo": {
              "type": "string",
              "minLength": 1
            },
            "commit": {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            }
          },
          "required": [
            "id",
            "sha256",
            "role",
            "kind",
            "scan_id",
            "repo",
            "commit"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "role": {
              "enum": [
                "target",
                "surrounding"
              ]
            },
            "kind": {
              "const": "context_snapshot"
            },
            "uri": {
              "type": "string",
              "minLength": 1
            },
            "title": {
              "type": "string",
              "minLength": 1
            },
            "revision": {
              "type": "string",
              "minLength": 1
            },
            "authority": {
              "enum": [
                "curated",
                "documentation",
                "team_note",
                "user_context"
              ]
            },
            "input_provenance": {
              "$ref": "#/$defs/InputProvenance"
            },
            "pins": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Pin"
              },
              "minItems": 0
            }
          },
          "required": [
            "id",
            "sha256",
            "role",
            "kind",
            "uri",
            "title",
            "revision",
            "authority",
            "input_provenance",
            "pins"
          ]
        }
      ]
    },
    "Model": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "provenance": {
          "enum": [
            "runtime_reported",
            "user_requested",
            "unknown"
          ]
        }
      },
      "required": [
        "name",
        "provenance"
      ]
    },
    "Usage": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "state": {
              "const": "measured"
            },
            "calls": {
              "type": "integer",
              "minimum": 1
            },
            "input_tokens": {
              "type": "integer",
              "minimum": 0
            },
            "output_tokens": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "state",
            "calls",
            "input_tokens",
            "output_tokens"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "state": {
              "const": "unknown"
            },
            "calls_lower_bound": {
              "type": "integer",
              "minimum": 1
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "state",
            "calls_lower_bound",
            "reason"
          ]
        }
      ]
    },
    "Run": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "author_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true,
          "description": "Actual author identities supplied by trusted orchestration, not model names. Omission means unknown and cannot establish independence from a reviewer."
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "$ref": "#/$defs/Model"
        },
        "started_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "description": "Actual model execution time, or null when unavailable; explain unknown timing in method. Never substitute serialisation time."
        },
        "finished_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "description": "Actual model execution time, or null when unavailable; explain unknown timing in method. Never substitute serialisation time."
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "input_context_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "usage": {
          "$ref": "#/$defs/Usage"
        }
      },
      "required": [
        "id",
        "provider",
        "model",
        "started_at",
        "finished_at",
        "method",
        "input_context_ids",
        "usage"
      ]
    },
    "Confirmation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "by": {
          "type": "string",
          "minLength": 1
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "by",
        "at",
        "notes"
      ]
    },
    "PurposeClaim": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "const": "inferred"
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "reasoning": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "$ref": "#/$defs/Confidence"
        },
        "alternatives": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "support": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "confirmation": {
          "$ref": "#/$defs/Confirmation"
        },
        "kind": {
          "const": "purpose"
        },
        "subject": {
          "$ref": "#/$defs/EntityReference"
        }
      },
      "required": [
        "id",
        "label",
        "statement",
        "reasoning",
        "confidence",
        "alternatives",
        "limitations",
        "support",
        "dependencies",
        "run_id",
        "kind",
        "subject"
      ]
    },
    "ActorClaim": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "const": "inferred"
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "reasoning": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "$ref": "#/$defs/Confidence"
        },
        "alternatives": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "support": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "confirmation": {
          "$ref": "#/$defs/Confirmation"
        },
        "kind": {
          "const": "actor"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "actor_type": {
          "enum": [
            "person",
            "organisation",
            "system",
            "unknown"
          ]
        },
        "goal": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "description": "The supported actor goal, or null when the examined evidence does not establish it."
        }
      },
      "required": [
        "id",
        "label",
        "statement",
        "reasoning",
        "confidence",
        "alternatives",
        "limitations",
        "support",
        "dependencies",
        "run_id",
        "kind",
        "name",
        "actor_type",
        "goal"
      ]
    },
    "ActionClaim": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "const": "inferred"
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "reasoning": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "$ref": "#/$defs/Confidence"
        },
        "alternatives": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "support": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "confirmation": {
          "$ref": "#/$defs/Confirmation"
        },
        "kind": {
          "const": "action"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "actor": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "description": "A supported actor claim reference, or null when the examined evidence does not establish the actor."
        },
        "entrypoints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1
        },
        "goal": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "label",
        "statement",
        "reasoning",
        "confidence",
        "alternatives",
        "limitations",
        "support",
        "dependencies",
        "run_id",
        "kind",
        "name",
        "actor",
        "entrypoints",
        "goal"
      ]
    },
    "JourneyClaim": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "const": "inferred"
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "reasoning": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "$ref": "#/$defs/Confidence"
        },
        "alternatives": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "support": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "confirmation": {
          "$ref": "#/$defs/Confirmation"
        },
        "kind": {
          "const": "journey"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "actor": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "description": "A supported actor claim reference, or null when the examined evidence does not establish the actor."
        },
        "goal": {
          "type": "string",
          "minLength": 1
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "action": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "action",
              "reason"
            ]
          },
          "minItems": 1
        }
      },
      "required": [
        "id",
        "label",
        "statement",
        "reasoning",
        "confidence",
        "alternatives",
        "limitations",
        "support",
        "dependencies",
        "run_id",
        "kind",
        "name",
        "actor",
        "goal",
        "steps"
      ]
    },
    "RelationshipClaim": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "const": "inferred"
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "reasoning": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "$ref": "#/$defs/Confidence"
        },
        "alternatives": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "support": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "confirmation": {
          "$ref": "#/$defs/Confirmation"
        },
        "kind": {
          "const": "relationship"
        },
        "from": {
          "$ref": "#/$defs/EntityReference"
        },
        "to": {
          "$ref": "#/$defs/EntityReference"
        },
        "relationship": {
          "enum": [
            "uses",
            "supports",
            "depends_on",
            "belongs_to",
            "hands_off_to"
          ]
        }
      },
      "required": [
        "id",
        "label",
        "statement",
        "reasoning",
        "confidence",
        "alternatives",
        "limitations",
        "support",
        "dependencies",
        "run_id",
        "kind",
        "from",
        "to",
        "relationship"
      ]
    },
    "Claim": {
      "oneOf": [
        {
          "$ref": "#/$defs/PurposeClaim"
        },
        {
          "$ref": "#/$defs/ActorClaim"
        },
        {
          "$ref": "#/$defs/ActionClaim"
        },
        {
          "$ref": "#/$defs/JourneyClaim"
        },
        {
          "$ref": "#/$defs/RelationshipClaim"
        }
      ]
    },
    "Attempt": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "area": {
          "enum": [
            "purpose",
            "actor",
            "action",
            "journey",
            "relationship"
          ]
        },
        "outcome": {
          "enum": [
            "claims_proposed",
            "insufficient_context",
            "not_applicable"
          ]
        },
        "claim_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "area",
        "outcome",
        "claim_ids",
        "reason",
        "run_id"
      ]
    },
    "Confidence": {
      "enum": [
        "low",
        "medium",
        "high"
      ]
    }
  },
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "scan-interpretation/v1"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "enum": [
        "pending",
        "partial",
        "complete"
      ]
    },
    "contexts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Context"
      },
      "minItems": 1
    },
    "runs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Run"
      },
      "minItems": 0
    },
    "claims": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Claim"
      },
      "minItems": 0
    },
    "attempts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Attempt"
      },
      "minItems": 0
    }
  },
  "required": [
    "format",
    "id",
    "state",
    "contexts",
    "runs",
    "claims",
    "attempts"
  ]
}
