{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "featureId": {
      "type": "string",
      "minLength": 1
    },
    "question": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "catalogRevision": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "context": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "capturedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "assumptions": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      }
    },
    "observations": {
      "minItems": 1,
      "maxItems": 10,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string"
          },
          "repository": {
            "type": [
              "string",
              "null"
            ]
          },
          "sourceRevision": {
            "type": [
              "string",
              "null"
            ]
          },
          "observation": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "relations": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "reason": {
                  "type": "string"
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "owner",
                    "dependency",
                    "contract",
                    "trace",
                    "trigger",
                    "step-ref",
                    "subject"
                  ]
                },
                "reverse": {
                  "type": "boolean"
                }
              },
              "required": [
                "id",
                "reason"
              ],
              "additionalProperties": false
            }
          },
          "componentGaps": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "area": {
                  "type": "string"
                },
                "reason": {
                  "type": "string"
                }
              },
              "required": [
                "area",
                "reason"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "name",
          "repository",
          "sourceRevision",
          "observation",
          "relations",
          "componentGaps"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "featureId",
    "question",
    "catalogRevision",
    "context",
    "capturedAt",
    "assumptions",
    "observations"
  ],
  "additionalProperties": false
}
