{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "checkoutId": {
      "type": "string"
    },
    "ref": {
      "type": "string"
    },
    "expectedRevision": {
      "type": "string",
      "minLength": 1
    },
    "expectedContext": {
      "type": "string",
      "minLength": 1
    },
    "featureId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$"
    },
    "legacyTaskId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$"
    },
    "taskId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$"
    },
    "branch": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "expectedRevision",
    "expectedContext",
    "featureId",
    "branch"
  ],
  "additionalProperties": false
}
