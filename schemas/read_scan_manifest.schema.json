{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "manifestId": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "section": {
      "default": "summary",
      "type": "string",
      "enum": [
        "summary",
        "files",
        "dependencyFingerprints",
        "mappings"
      ]
    },
    "offset": {
      "default": 0,
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "limit": {
      "default": 20,
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "expectedRevision": {
      "type": "string"
    },
    "checkoutId": {
      "type": "string"
    },
    "ref": {
      "type": "string"
    }
  },
  "required": [
    "section",
    "offset",
    "limit"
  ],
  "additionalProperties": false
}
