{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "featureId": {
      "type": "string",
      "minLength": 1
    },
    "baselineId": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "expectedRevision": {
      "type": "string",
      "minLength": 1
    },
    "expectedContext": {
      "type": "string",
      "minLength": 1
    },
    "sources": {
      "default": [],
      "maxItems": 10,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "repository": {
            "type": "string",
            "minLength": 1
          },
          "repositoryPath": {
            "type": "string",
            "minLength": 1
          },
          "targetRef": {
            "type": "string",
            "minLength": 1
          },
          "ids": {
            "minItems": 1,
            "maxItems": 10,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "repositoryPath",
          "targetRef",
          "ids"
        ],
        "additionalProperties": false
      }
    },
    "checkoutId": {
      "type": "string"
    }
  },
  "required": [
    "featureId",
    "baselineId",
    "expectedRevision",
    "expectedContext",
    "sources"
  ],
  "additionalProperties": false
}
