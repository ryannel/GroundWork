{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "featureId": {
      "type": "string"
    },
    "baselineId": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "checkedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "catalogRevision": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "context": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "catalogState": {
            "type": "string",
            "enum": [
              "unchanged",
              "changed",
              "removed"
            ]
          },
          "sourceFreshness": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "catalogState",
          "sourceFreshness"
        ],
        "additionalProperties": false
      }
    },
    "checks": {
      "maxItems": 10,
      "type": "array",
      "items": {
        "type": "object",
        "propertyNames": {
          "type": "string"
        },
        "additionalProperties": {}
      }
    },
    "reassessmentRequired": {
      "type": "boolean"
    },
    "note": {
      "type": "string"
    }
  },
  "required": [
    "version",
    "featureId",
    "baselineId",
    "checkedAt",
    "catalogRevision",
    "context",
    "observations",
    "checks",
    "reassessmentRequired",
    "note"
  ],
  "additionalProperties": false
}
