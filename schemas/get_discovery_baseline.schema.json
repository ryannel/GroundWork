{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "featureId": {
      "type": "string",
      "pattern": "^(?!(?:constructor|prototype|__proto__)$)[a-zA-Z0-9][a-zA-Z0-9_-]*$"
    },
    "baselineId": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "checkoutId": {
      "type": "string"
    },
    "ref": {
      "type": "string"
    }
  },
  "required": [
    "featureId",
    "baselineId"
  ],
  "additionalProperties": false
}
