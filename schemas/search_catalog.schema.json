{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "query": {
      "default": "",
      "type": "string",
      "maxLength": 2000
    },
    "componentId": {
      "type": "string"
    },
    "productId": {
      "type": "string"
    },
    "kinds": {
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "component",
          "endpoint",
          "schema",
          "data",
          "message",
          "flow",
          "finding",
          "job"
        ]
      }
    },
    "limit": {
      "default": 10,
      "type": "integer",
      "minimum": 1,
      "maximum": 50
    },
    "maxBytes": {
      "default": 32768,
      "type": "integer",
      "minimum": 4096,
      "maximum": 65536
    },
    "cursor": {
      "type": "string",
      "maxLength": 2048
    },
    "checkoutId": {
      "type": "string"
    },
    "ref": {
      "type": "string"
    }
  },
  "required": [
    "query",
    "limit",
    "maxBytes"
  ],
  "additionalProperties": false
}
