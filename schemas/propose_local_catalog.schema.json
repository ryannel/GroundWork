{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "checkoutId": {
      "type": "string"
    },
    "productId": {
      "type": "string",
      "minLength": 1
    },
    "repository": {
      "type": "string",
      "minLength": 1
    },
    "sourceRoot": {
      "type": "string",
      "minLength": 1
    },
    "apply": {
      "type": "boolean"
    },
    "expectedProposalId": {
      "type": "string"
    }
  },
  "required": [
    "productId",
    "repository",
    "sourceRoot"
  ],
  "additionalProperties": false
}
