{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "repository": {
      "type": "string",
      "minLength": 1
    },
    "remote": {
      "type": "string",
      "minLength": 1
    },
    "recordedCommits": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "repository",
    "remote"
  ],
  "additionalProperties": false
}
