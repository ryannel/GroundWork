{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "checkoutId": {
      "type": "string"
    },
    "ref": {
      "type": "string"
    },
    "expectedRevision": {
      "type": "string",
      "minLength": 1
    },
    "expectedContext": {
      "type": "string",
      "minLength": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "productId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$"
    },
    "ownerId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$"
    },
    "problem": {
      "type": "string",
      "minLength": 1
    },
    "outcome": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "expectedRevision",
    "expectedContext",
    "id",
    "title",
    "productId",
    "ownerId",
    "problem",
    "outcome"
  ],
  "additionalProperties": false
}
