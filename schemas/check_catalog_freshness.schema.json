{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "repository": {
      "type": "string",
      "minLength": 1
    },
    "repositoryPath": {
      "type": "string",
      "minLength": 1
    },
    "targetRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "ids": {
      "minItems": 1,
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      }
    },
    "maxFiles": {
      "default": 50,
      "type": "integer",
      "minimum": 0,
      "maximum": 200
    },
    "maxBytes": {
      "default": 32768,
      "type": "integer",
      "minimum": 8192,
      "maximum": 65536
    },
    "checkoutId": {
      "type": "string"
    },
    "ref": {
      "type": "string"
    }
  },
  "required": [
    "repositoryPath",
    "targetRef",
    "ids",
    "maxFiles",
    "maxBytes"
  ],
  "additionalProperties": false
}
