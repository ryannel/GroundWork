{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "checkoutId": {
      "type": "string"
    },
    "ref": {
      "type": "string"
    },
    "expectedRevision": {
      "type": "string",
      "minLength": 1
    },
    "expectedContext": {
      "type": "string",
      "minLength": 1
    },
    "featureId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$"
    },
    "unitId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$"
    },
    "status": {
      "type": "string",
      "enum": [
        "planned",
        "in-progress",
        "blocked",
        "done"
      ]
    },
    "stage": {
      "type": "string",
      "enum": [
        "idea",
        "exploring",
        "designing",
        "specced",
        "building",
        "shipped"
      ]
    },
    "evidence": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "allOf": [
            {
              "pattern": "\\S"
            },
            {
              "pattern": "^(?!(?:constructor|prototype|__proto__)$)[a-zA-Z0-9][a-zA-Z0-9_-]*$"
            }
          ]
        },
        "legacyTaskId": {
          "type": "string",
          "minLength": 1,
          "allOf": [
            {
              "pattern": "\\S"
            },
            {
              "pattern": "^(?!(?:constructor|prototype|__proto__)$)[a-zA-Z0-9][a-zA-Z0-9_-]*$"
            }
          ]
        },
        "taskId": {
          "type": "string",
          "minLength": 1,
          "allOf": [
            {
              "pattern": "\\S"
            },
            {
              "pattern": "^(?!(?:constructor|prototype|__proto__)$)[a-zA-Z0-9][a-zA-Z0-9_-]*$"
            }
          ]
        },
        "validationId": {
          "type": "string",
          "minLength": 1,
          "allOf": [
            {
              "pattern": "\\S"
            },
            {
              "pattern": "^(?!(?:constructor|prototype|__proto__)$)[a-zA-Z0-9][a-zA-Z0-9_-]*$"
            }
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "result": {
          "type": "string",
          "enum": [
            "unverified",
            "passed",
            "failed"
          ]
        },
        "recordedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "reference": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "testedRevision": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "environment": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": [
        "id",
        "description",
        "result",
        "recordedAt"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "expectedRevision",
    "expectedContext",
    "featureId"
  ],
  "additionalProperties": false
}
