{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "tables": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "allOf": [
              {
                "pattern": "\\S"
              },
              {
                "pattern": "^(?!(?:constructor|prototype|__proto__)$)[a-zA-Z0-9][a-zA-Z0-9_-]*$"
              }
            ]
          },
          "component": {
            "type": "string",
            "minLength": 1,
            "allOf": [
              {
                "pattern": "\\S"
              },
              {
                "pattern": "^(?!(?:constructor|prototype|__proto__)$)[a-zA-Z0-9][a-zA-Z0-9_-]*$"
              }
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "group": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "kind": {
            "type": "string",
            "enum": [
              "table",
              "object",
              "local-file"
            ]
          },
          "change": {
            "type": "string",
            "enum": [
              "added",
              "updated",
              "removed",
              "unchanged",
              "unspecified"
            ]
          },
          "columns": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "type": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "note": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "key": {
                  "type": "boolean"
                },
                "change": {
                  "type": "string",
                  "enum": [
                    "added",
                    "updated",
                    "removed",
                    "unchanged",
                    "unspecified"
                  ]
                }
              },
              "required": [
                "name",
                "type"
              ],
              "additionalProperties": false
            }
          },
          "note": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "required": [
          "id",
          "component",
          "name",
          "change",
          "columns"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "tables"
  ],
  "additionalProperties": false
}
