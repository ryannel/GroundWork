{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "scanId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "componentId": {
      "type": "string",
      "minLength": 1
    },
    "expectedRevision": {
      "type": "string",
      "minLength": 1
    },
    "expectedContext": {
      "type": "string",
      "minLength": 1
    },
    "retire": {
      "default": [],
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "endpoint",
              "schema",
              "data",
              "message",
              "job",
              "flow"
            ]
          },
          "id": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "evidence": {
            "minItems": 1,
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "lines": {
                  "type": "string",
                  "pattern": "^\\d+(?:-\\d+)?$"
                },
                "claim": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "revision": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "repository": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              },
              "required": [
                "path",
                "lines",
                "claim",
                "revision"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "kind",
          "id",
          "reason",
          "evidence"
        ],
        "additionalProperties": false
      }
    },
    "rename": {
      "default": [],
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "endpoint",
              "schema",
              "data",
              "message",
              "job",
              "flow"
            ]
          },
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "minItems": 1,
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "lines": {
                  "type": "string",
                  "pattern": "^\\d+(?:-\\d+)?$"
                },
                "claim": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "revision": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "repository": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              },
              "required": [
                "path",
                "lines",
                "claim",
                "revision"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "kind",
          "id",
          "name",
          "evidence"
        ],
        "additionalProperties": false
      }
    },
    "checkoutId": {
      "type": "string"
    }
  },
  "required": [
    "scanId",
    "componentId",
    "expectedRevision",
    "expectedContext",
    "retire",
    "rename"
  ],
  "additionalProperties": false
}
