                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  }
                },
                "evidence": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "path": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "\\S"
                      },
                      "lines": {
                        "type": "string",
                        "pattern": "^[1-9]\\d*(?:-[1-9]\\d*)?$"
                      },
                      "claim": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "\\S"
                      },
                      "revision": {
                        "type": "string",
                        "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
                      },
                      "repository": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "\\S"
                      }
                    },
                    "required": [
                      "path",
                      "lines",
                      "claim",
                      "revision"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "id",
                "title",
                "kind",
                "description",
                "evidence"
              ],
              "additionalProperties": false
            }
          },
          "transitions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "allOf": [
                    {
                      "pattern": "\\S"
                    },
                    {
                      "pattern": "^(?!(?:constructor|prototype|__proto__)$)[a-zA-Z0-9][a-zA-Z0-9_-]*$"
                    }
                  ]
                },
                "from": {
                  "type": "string",
                  "minLength": 1,
                  "allOf": [
                    {
                      "pattern": "\\S"
                    },
                    {
                      "pattern": "^(?!(?:constructor|prototype|__proto__)$)[a-zA-Z0-9][a-zA-Z0-9_-]*$"
                    }
                  ]
                },
                "to": {
                  "type": "string",
                  "minLength": 1,
                  "allOf": [
                    {
                      "pattern": "\\S"
                    },
                    {
                      "pattern": "^(?!(?:constructor|prototype|__proto__)$)[a-zA-Z0-9][a-zA-Z0-9_-]*$"
                    }
                  ]
                },
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "mode": {
                  "type": "string",
                  "enum": [
                    "sync",
                    "async"
                  ]
                },
                "evidence": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "path": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "\\S"
                      },
                      "lines": {
                        "type": "string",
                        "pattern": "^[1-9]\\d*(?:-[1-9]\\d*)?$"
                      },
                      "claim": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "\\S"
                      },
                      "revision": {
                        "type": "string",
                        "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
                      },
                      "repository": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "\\S"
                      }
                    },
                    "required": [
                      "path",
                      "lines",
                      "claim",
                      "revision"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "id",
                "from",
                "to",
                "label",
                "mode",
                "evidence"
              ],
              "additionalProperties": false
            }
          },
          "gaps": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          }
        },
        "required": [
          "id",
          "name",
          "summary",
          "sourceRevision",
          "entryStepId",
          "steps",
          "transitions",
          "gaps"
        ],
        "additionalProperties": false
      }
    },
    "findings": {
      "default": [],
      "maxItems": 10,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "allOf": [
              {
                "pattern": "\\S"
              },
              {
                "pattern": "^(?!(?:constructor|prototype|__proto__)$)[a-zA-Z0-9][a-zA-Z0-9_-]*$"
              }
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "\\S"
          },
          "question": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "pattern": "\\S"
          },
          "answer": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8000,
            "pattern": "\\S"
          },
          "subjects": {
            "minItems": 1,
            "maxItems": 10,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "component",
                    "endpoint",
                    "schema",
                    "data",
                    "message",
                    "job",
                    "flow"
                  ]
                },
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              },
              "required": [
                "kind",
                "id"
              ],
              "additionalProperties": false
            }
          },
          "boundary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000,
            "pattern": "\\S"
          },
          "assumptions": {
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "repository": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "sourceRevision": {
            "type": "string",
            "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
          },
          "evidence": {
            "minItems": 1,
            "maxItems": 40,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "lines": {
                  "type": "string",
                  "pattern": "^[1-9]\\d*(?:-[1-9]\\d*)?$"
                },
                "claim": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "revision": {
                  "type": "string",
                  "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
                },
                "repository": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              },
              "required": [
                "path",
                "lines",
                "claim",
                "revision"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "name",
          "question",
          "answer",
          "subjects",
          "boundary",
          "assumptions",
          "repository",
          "sourceRevision",
          "evidence"
        ],
        "additionalProperties": false
      }
    },
    "checkoutId": {
      "type": "string"
    }
  },
  "required": [
    "sourceScans",
    "scanId",
    "componentId",
    "expectedRevision",
    "expectedContext",
    "jobs",
    "flows",
    "findings"
  ],
  "additionalProperties": false
}
