{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "limit": {
      "default": 10,
      "type": "integer",
      "minimum": 1,
      "maximum": 50
    },
    "maxBytes": {
      "default": 32768,
      "type": "integer",
      "minimum": 4096,
      "maximum": 65536
    },
    "cursor": {
      "type": "string",
      "maxLength": 2048
    },
    "checkoutId": {
      "type": "string"
    },
    "ref": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "limit",
    "maxBytes"
  ],
  "additionalProperties": false
}
