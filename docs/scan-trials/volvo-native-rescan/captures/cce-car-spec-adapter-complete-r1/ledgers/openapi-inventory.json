    "/v1/local-editions": {
      "get": {
        "security": [
          {
            "BearerToken": []
          }
        ],
        "description": "Returns all local editions, with optional filtering by specMarket, modelYear, pno12 and carType.",
        "produces": ["application/json"],
        "tags": ["Local Editions"],
        "summary": "List local editions",
        "parameters": [
          {
            "type": "string",
            "description": "Spec Market",
            "name": "specMarket",
            "in": "query"
          },
          {
            "type": "integer",
            "description": "Model Year",
            "name": "modelYear",
            "in": "query"
          },
          {
            "type": "string",
            "description": "Pno12",
            "name": "pno12",
            "in": "query"
          },
          {
            "type": "string",
            "description": "Car Type (first 3 characters of pno12)",
            "name": "carType",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/ListLocalEditionsResponse"
            }
          },
          "400": {
            "description": "Bad Request",
            "schema": {
              "$ref": "#/definitions/respond.ErrorResponse"
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "500": {
            "description": "Internal Server Error",
            "schema": {
              "$ref": "#/definitions/respond.ErrorResponse"
            }
          }
        }
      },
      "put": {
        "security": [
          {
            "BearerToken": []
          }
        ],
        "description": "Inserts or updates the local edition entry for the given car.\nValidates against the market auth document. Returns 201 on creation and\n422 if validation against market auth fails. To bypass the validation that\nchecks if the pno12 exists in the market auth document and if the local\nedition code exists for that pno12 in the market auth document, add the query\nparam \"skipValidation=true\".",
        "consumes": ["application/json"],
        "produces": ["application/json"],
        "tags": ["Local Editions"],
        "summary": "Create or update a local edition",
        "parameters": [
          {
            "type": "boolean",
            "description": "Skip validation",
            "name": "skipValidation",
            "in": "query"
          },
          {
            "description": "Local edition to upsert",
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/internal_api_httpserver_localeditions.UpsertLocalEditionRequest"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Created",
            "schema": {
              "$ref": "#/definitions/LocalEditionResponse"
            }
          },
          "400": {
            "description": "Bad Request",
            "schema": {
              "$ref": "#/definitions/respond.ErrorResponse"
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "422": {
            "description": "Unprocessable Entity",
            "schema": {
              "$ref": "#/definitions/respond.ErrorResponse"
            }
          },
          "500": {
            "description": "Internal Server Error",
            "schema": {
              "$ref": "#/definitions/respond.ErrorResponse"
            }
          }
        }
      },
      "delete": {
        "security": [
          {
            "BearerToken": []
          }
        ],
        "description": "Deletes the local edition entry for the given spec market, model year and pno12.",
        "produces": ["application/json"],
        "tags": ["Local Editions"],
        "summary": "Delete a local edition",
        "parameters": [
          {
            "type": "string",
            "description": "Spec Market",
            "name": "specMarket",
            "in": "query",
            "required": true
          },
          {
            "type": "integer",
            "description": "Model Year",
            "name": "modelYear",
            "in": "query",
            "required": true
          },
          {
            "type": "string",
            "description": "Pno12",
            "name": "pno12",
            "in": "query",
            "required": true
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "400": {
            "description": "Bad Request",
            "schema": {
              "$ref": "#/definitions/respond.ErrorResponse"
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "500": {
            "description": "Internal Server Error",
            "schema": {
              "$ref": "#/definitions/respond.ErrorResponse"
            }
          }
        }
      }
    }
