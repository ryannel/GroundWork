            "name": "modelYear",
            "in": "query",
            "required": true
          },
          {
            "type": "string",
            "description": "Pno12",
            "name": "pno12",
            "in": "query",
            "required": true
          },
          {
            "type": "string",
            "description": "Local Trim Edition Code (deprecated)",
            "name": "localTrimEditionCode",
            "in": "query"
          },
          {
            "type": "string",
            "description": "Local Edition Code",
            "name": "localEditionCode",
            "in": "query"
          }
        ],
        "responses": {
